# Minimal centered logo splash for DogeOS.
logo = Image("logo.png");
sprite = Sprite(logo);
sprite.SetX(Window.GetWidth() / 2 - logo.GetWidth() / 2);
sprite.SetY(Window.GetHeight() / 2 - logo.GetHeight() / 2);
sprite.SetZ(10);

fun refresh_callback() {
	sprite.SetOpacity(1);
}

Plymouth.SetRefreshFunction(refresh_callback);
