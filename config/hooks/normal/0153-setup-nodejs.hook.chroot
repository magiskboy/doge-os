#!/bin/sh
# Setup Node.js stack: fnm + pinned Node + JS/TS LSP tools (system-wide).
# Remove apt nodejs/npm from package-lists — do not mix with fnm on PATH.
set -e

FNM_VER=1.39.0
NODE_VER=22

TMP=$(mktemp -d)
cleanup() { rm -rf "$TMP"; }
trap cleanup EXIT
cd "$TMP"

curl -fsSL -o fnm.zip \
	"https://github.com/Schniz/fnm/releases/download/v${FNM_VER}/fnm-linux.zip"
unzip -q fnm.zip
install -m 755 fnm /usr/local/bin/fnm

export FNM_DIR=/usr/local/share/fnm
mkdir -p "$FNM_DIR"
eval "$(fnm env --shell bash --fnm-dir "$FNM_DIR")"

fnm install "$NODE_VER"
fnm default "$NODE_VER"

# Global CLIs / LSPs used by nvim (ts_ls, html/css/json, yamlls, pyright).
npm install -g \
	typescript \
	typescript-language-server \
	vscode-langservers-extracted \
	yaml-language-server \
	pyright
