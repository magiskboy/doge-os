#!/bin/sh
# Install Helm from official release tarball (not in Debian apt).
# Use the tarball binary into /usr/local/bin — same pattern as k9s/helmfile.
set -e

HELM_VER=4.2.3

TMP=$(mktemp -d)
cleanup() { rm -rf "$TMP"; }
trap cleanup EXIT
cd "$TMP"

curl -fsSL -o helm.tar.gz \
	"https://get.helm.sh/helm-v${HELM_VER}-linux-amd64.tar.gz"

tar -xzf helm.tar.gz
install -m 755 linux-amd64/helm /usr/local/bin/helm
