#!/bin/sh
# Setup zsh for new users: default login shell + Oh My Zsh in /etc/skel.
# Packages (zsh, zsh-autosuggestions, zsh-syntax-highlighting) come from package-lists.
# Use GitHub archive (not git clone --filter): partial clones hang under fakeroot.
set -e

OMZ_COMMIT=677a4592b18c08ddea737f8aca70bac0e9fc9313

# --- Default login shell (adduser / live-config) ---
# Live user is created at boot by live-config → user-setup-apply → adduser, which
# reads DSHELL. On Debian adduser ≥3.15x the stock line is commented (#DSHELL=…),
# so a plain ^DSHELL= sed never applies — leave bash as the effective default.
if ! command -v zsh >/dev/null 2>&1 && [ ! -x /bin/zsh ] && [ ! -x /usr/bin/zsh ]; then
	echo "zsh is not installed — add it to package-lists before this hook" >&2
	exit 1
fi

# Prefer /bin/zsh (what Debian ships in /etc/shells); fall back to PATH.
ZSH_PATH=/bin/zsh
if [ ! -x "$ZSH_PATH" ]; then
	ZSH_PATH=$(command -v zsh)
fi

if grep -qE '^[[:space:]]*#?[[:space:]]*DSHELL=' /etc/adduser.conf; then
	sed -i -E "s|^[[:space:]]*#?[[:space:]]*DSHELL=.*|DSHELL=${ZSH_PATH}|" /etc/adduser.conf
else
	printf '\nDSHELL=%s\n' "$ZSH_PATH" >> /etc/adduser.conf
fi

if [ -f /etc/default/useradd ]; then
	if grep -qE '^[[:space:]]*#?[[:space:]]*SHELL=' /etc/default/useradd; then
		sed -i -E "s|^[[:space:]]*#?[[:space:]]*SHELL=.*|SHELL=${ZSH_PATH}|" /etc/default/useradd
	else
		printf '\nSHELL=%s\n' "$ZSH_PATH" >> /etc/default/useradd
	fi
fi

# chsh only accepts shells listed here (Debian Wiki / Oh My Zsh).
if [ -f /etc/shells ] && ! grep -qxF "$ZSH_PATH" /etc/shells; then
	echo "$ZSH_PATH" >> /etc/shells
fi

# --- Oh My Zsh → /etc/skel (picked up by adduser) ---
ZSH=/etc/skel/.oh-my-zsh
TMP=$(mktemp -d)
cleanup() { rm -rf "$TMP"; }
trap cleanup EXIT

curl -fsSL -o "$TMP/omz.tar.gz" \
	"https://github.com/ohmyzsh/ohmyzsh/archive/${OMZ_COMMIT}.tar.gz"
tar -xzf "$TMP/omz.tar.gz" -C "$TMP"
rm -rf "$ZSH"
mv "$TMP/ohmyzsh-${OMZ_COMMIT}" "$ZSH"
