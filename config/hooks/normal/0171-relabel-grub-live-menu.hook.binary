#!/bin/sh
# Live menu titles are generated by live-build (binary_grub_cfg), not the templates.
# Relabel "Live system*" → "DogeOS*" after GRUB configs are written.
set -e

for f in binary/boot/grub/*.cfg; do
	[ -f "$f" ] || continue
	sed -i \
		-e 's/Live system (autodetect)/DogeOS (autodetect)/g' \
		-e 's/Live system (/DogeOS (/g' \
		-e 's/Live system,/DogeOS,/g' \
		-e 's/Live system/DogeOS/g' \
		"$f"
done
