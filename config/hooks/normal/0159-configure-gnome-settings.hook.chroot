#!/bin/sh
# Compile DogeOS gsettings schema overrides and set Dash / Dash-to-Dock defaults.
set -e

SCHEMA_DIR=/usr/share/glib-2.0/schemas

# Favorites order (left → right / top → bottom):
# Files, Chrome, VS Code, DBeaver, Terminal (Ptyxis), Settings
cat > "$SCHEMA_DIR/90_doge-favorite-apps.gschema.override" <<'EOF'
[org.gnome.shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'google-chrome.desktop', 'code.desktop', 'dbeaver-ce.desktop', 'org.gnome.Ptyxis.desktop', 'org.gnome.Settings.desktop']
EOF

# Ensure background override exists even if generate-branding-assets.sh was not run.
if [ ! -f "$SCHEMA_DIR/90_doge-background.gschema.override" ]; then
	cat > "$SCHEMA_DIR/90_doge-background.gschema.override" <<'EOF'
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/dogeos/wallpaper-4.jpg'
picture-uri-dark='file:///usr/share/backgrounds/dogeos/wallpaper-4.jpg'
picture-options='zoom'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/dogeos/wallpaper-4.jpg'
picture-options='zoom'
EOF
fi

if command -v glib-compile-schemas >/dev/null 2>&1; then
	glib-compile-schemas "$SCHEMA_DIR"
fi
