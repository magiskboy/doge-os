#!/bin/sh
# Setup Go from official tarball into /usr/local/go (pinned version).
# Do not mix with apt golang-go. PATH is set in skel .zshrc.
set -e

GO_VER=1.26.5

TMP=$(mktemp -d)
cleanup() { rm -rf "$TMP"; }
trap cleanup EXIT
cd "$TMP"

curl -fsSL -o go.tar.gz \
	"https://go.dev/dl/go${GO_VER}.linux-amd64.tar.gz"

# Official docs: remove previous install before extract (do not untar over existing tree).
rm -rf /usr/local/go
tar -C /usr/local -xzf go.tar.gz
